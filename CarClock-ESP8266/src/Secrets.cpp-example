//----------------------------------------------------------------------------
//
//  Secrets.cpp
//
//      Rename this file (Secrets.cpp-example) to Secrets.cpp then
//      set your :
//
//          - Default timezone (MY_TIMEZONE).
//
//          - List of SSIDs and passwords (max NUM_WIFI_PREFERRED).
//
//----------------------------------------------------------------------------


//
//  Local include files :
//
#include "Common.h"


//----------------------------------------------------------------------------
//
//  MY_TIMEZONE -- Our default timezone.
//
//      Examples of what to use with the setPosix() call :
//
//          New York (EST)      EST5EDT,M3.2.0,M11.1.0
//          Chicago (CST)       CST6CDT,M3.2.0,M11.1.0
//          Denver (MST)        MST7MDT,M3.2.0,M11.1.0
//          Los Angeles (PST)   PST8PDT,M3.2.0,M11.1.0
//          London (GMT/BST)    GMT0BST,M3.5.0/1,M10.5.0
//          Phoenix (No DST)    MST7
//
//----------------------------------------------------------------------------

const char* MY_TIMEZONE     = "CST6CDT,M3.2.0,M11.1.0";


//----------------------------------------------------------------------------
//
//  WIFI_PREFERRED[] -- Array containing list preferred SSIDs & passwords.
//
//      Note that there is no limit to the number of entries in this list
//      (well, yeah there are technical limits like memory on the ESP, etc,
//      but I think you know what I mean... :-)
//
//----------------------------------------------------------------------------

tWiFiCredentials    WIFI_PREFERRED[] =
{
    { "Dummy-Secure-WiFi"       , "password"    },      // Example of a preferred secure network.
    { "Dummy-Secure-WiFi-2"     , "password-2"  },      // Example of another preferred secure network.
    { "Dummy-Open-WiFi"         , ""            },      // Example of a preferred open (non-secure) network.
};

const int   NUM_WIFI_PREFERRED      = ( sizeof(WIFI_PREFERRED) / sizeof(tWiFiCredentials) );


//----------------------------------------------------------------------------
//
//  SecretsSetup() -- Routine to initialize secret stuff.
//
//----------------------------------------------------------------------------

void SecretsSetup ( void )
{
    //
    //  Local variables :
    //
    int     idx;
    char    buf[40];                    // Text buffer big enough to hold 32-character SSID + "[]".


    //
    //  Display a header message :
    //
    MyPrintf ( "[SecretsSetup]  ----------------------------\n" );
    MyPrintf ( "[SecretsSetup]  Called.\n" );


    //
    //  Display the list of preferred WiFi networks :
    //
    MyPrintf ( "[SecretsSetup]  We have %d preferred WiFi networks :\n", NUM_WIFI_PREFERRED );
    MyPrintf ( "[SecretsSetup]    Idx                 SSID                 Sec\n" );
    MyPrintf ( "[SecretsSetup]    ---  ----------------------------------  ---\n" );
//  MyPrintf ( "[SecretsSetup]    xx   xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   x\n" );

    for ( idx = 0 ; idx < NUM_WIFI_PREFERRED ; idx++ )
    {
        snprintf ( buf, sizeof(buf), "[%s]", WIFI_PREFERRED[idx].SSID );

        MyPrintf ( "[SecretsSetup]    %2d   %-34s   %c\n",
            idx,
            buf,
            ( ( strlen(WIFI_PREFERRED[idx].passwd) > 0 ) ? '*' : ' ' ) );
    } // for
}


//----------------------------------------------------------------------------
//
//  end of  Secrets.cpp
//
//----------------------------------------------------------------------------
