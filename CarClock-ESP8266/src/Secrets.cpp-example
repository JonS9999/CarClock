//----------------------------------------------------------------------------
//
//  Secrets.cpp
//
//      Rename this file (Secrets.cpp-example) to Secrets.cpp then
//      set your :
//
//          - Default timezone (MY_TIMEZONE).
//
//          - List of SSIDs and passwords (max MAX_WIFI_NETWORKS).
//
//----------------------------------------------------------------------------


//
//  Local include files :
//
#include "Common.h"


//----------------------------------------------------------------------------
//
//  MY_TIMEZONE -- Our default timezone.
//
//      Examples of what to use with the setPosix() call :
//
//          New York (EST)      EST5EDT,M3.2.0,M11.1.0
//          Chicago (CST)       CST6CDT,M3.2.0,M11.1.0
//          Denver (MST)        MST7MDT,M3.2.0,M11.1.0
//          Los Angeles (PST)   PST8PDT,M3.2.0,M11.1.0
//          London (GMT/BST)    GMT0BST,M3.5.0/1,M10.5.0
//          Phoenix (No DST)    MST7
//
//----------------------------------------------------------------------------

const char* MY_TIMEZONE     = "CST6CDT,M3.2.0,M11.1.0";


//----------------------------------------------------------------------------
//
//  SecretsSetup() -- Routine to initialize secret stuff.
//
//----------------------------------------------------------------------------

void SecretsSetup ( void )
{
    MyPrintf ( "[SecretsSetup]  Called.\n" );


    //
    //  First WiFi network we will attempt to connect to :
    //
    snprintf ( config.wifiSlots[0].ssid, sizeof(config.wifiSlots[0].ssid), "My_Home_WiFi" );
    snprintf ( config.wifiSlots[0].pass, sizeof(config.wifiSlots[0].pass), "somePassword" );

    //
    //  Second WiFi network we will attempt to connect to :
    //
    snprintf ( config.wifiSlots[1].ssid, sizeof(config.wifiSlots[0].ssid), "My_Phone_WiFi" );
    snprintf ( config.wifiSlots[1].pass, sizeof(config.wifiSlots[0].pass), "someOtherPassword" );
}


//----------------------------------------------------------------------------
//
//  end of  Secrets.cpp
//
//----------------------------------------------------------------------------
